{
  "version": "0.2",

  // This repository is written in two languages. Prose is American English; the comments in
  // demo.http are Spanish, and so is much of the reasoning in this file.
  //
  // "language" alone is not enough to reach Spanish: cspell resolves a language id to a dictionary
  // only when it can find one registered for that locale, and it does not scan node_modules for
  // packages whose name it does not already know. Verified: `{"language": "en,es"}` leaves every
  // Spanish word in demo.http reported, and so does adding `"dictionaries": ["es-es"]` on its own.
  // What works is declaring the dictionary's path explicitly, which is what the dictionaryDefinitions
  // entry below does. The package has to be a devDependency for that path to exist at all.
  "language": "en",

  "dictionaries": ["es-es", "shell", "project-words"],
  "dictionaryDefinitions": [
    {
      "name": "es-es",
      "path": "./node_modules/@cspell/dict-es-es/Spanish.trie.gz"
    },
    {
      // @cspell/dict-bash ships as a wrapper that imports @cspell/dict-shell, and cspell does not
      // follow that indirection from a path. Pointing at the real word list is what loads it.
      //
      // The dictionary is here because the files in .githooks have no extension, so cspell reads them
      // as plain text and never applies its shellscript language setting. Measured: without this,
      // `esac` is reported five times in .githooks/commit-msg.
      "name": "shell",
      "path": "./node_modules/@cspell/dict-shell/dict/shell-all-words.txt"
    },
    {
      "name": "project-words",
      "path": "./project-words.txt"
    }
  ],

  "useGitignore": true,
  "ignorePaths": [
    // Git's own directory, which the `.*/**` glob reaches along with everything else that starts
    // with a dot. It holds hundreds of files that belong to Git, not to this repository, and the
    // sample hooks in .git/hooks are full of words no dictionary has. Measured: without this line the
    // step reports 41 skipped files and reads the lot.
    ".git",

    // Generated by npm; full of hashes and package names.
    "package-lock.json",
    // The dictionary itself: spell checking a list of deliberately unusual words is circular.
    "project-words.txt",
    // Local secrets. Gitignored, so useGitignore already covers these, and naming them is redundant
    // on purpose: a mistyped ignore rule would otherwise turn the spell checker into a way to read a
    // token aloud in a CI log.
    ".dev.vars",
    ".env",
    "http-client.private.env.json"
  ]
}
