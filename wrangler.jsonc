{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "cfpoc",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cfpoc-events",
      "database_id": "REPLACE_WITH_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
}
