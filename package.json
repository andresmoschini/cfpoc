{
  "name": "cfpoc",
  "version": "0.1.0",
  "private": true,
  "description": "Small Cloudflare Workers + D1 proof of concept",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create cfpoc-events",
    "db:migrate:local": "wrangler d1 migrations apply cfpoc-events --local",
    "db:migrate:remote": "wrangler d1 migrations apply cfpoc-events --remote",
    "db:query:local": "wrangler d1 execute cfpoc-events --local --command=\"SELECT * FROM events ORDER BY id DESC;\"",
    "db:query:remote": "wrangler d1 execute cfpoc-events --remote --command=\"SELECT * FROM events ORDER BY id DESC;\"",
    "db:execute:local": "wrangler d1 execute cfpoc-events --local --command",
    "db:execute:remote": "wrangler d1 execute cfpoc-events --remote --command",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261001.1",
    "@cspell/dict-bash": "4.2.3",
    "@cspell/dict-es-es": "3.0.8",
    "cspell": "10.3.6",
    "editorconfig-checker": "6.2.0",
    "markdownlint-cli2": "0.23.3",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "wrangler": "4.145.0"
  }
}
